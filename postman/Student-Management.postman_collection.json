{
  "info": {
    "name": "Student Management Microservices",
    "description": "Postman collection for testing authentication, student management, course management, enrollments, and API Gateway endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "authUrl",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "studentUrl",
      "value": "http://127.0.0.1:8002"
    },
    {
      "key": "courseUrl",
      "value": "http://127.0.0.1:8003"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "studentId",
      "value": "1"
    },
    {
      "key": "courseId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"student_test\",\n  \"password\": \"TestPassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{authUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.access_token) {",
                  "        pm.collectionVariables.set('token', data.access_token);",
                  "        console.log('Access token saved.');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "student_test",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "TestPassword123",
                  "type": "text"
                }
              ]
            },
            "url": "{{authUrl}}/auth/login"
          },
          "auth": {
            "type": "noauth"
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "url": "{{studentUrl}}/students/"
          }
        },
        {
          "name": "Get Student by ID",
          "request": {
            "method": "GET",
            "url": "{{studentUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"student@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{studentUrl}}/students/"
          }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Student\",\n  \"email\": \"updated@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{studentUrl}}/students/{{studentId}}"
          }
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
            "url": "{{studentUrl}}/students/{{studentId}}"
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "url": "{{courseUrl}}/courses/"
          }
        },
        {
          "name": "Get Course by ID",
          "request": {
            "method": "GET",
            "url": "{{courseUrl}}/courses/{{courseId}}"
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Course\",\n  \"description\": \"Course created for API testing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{courseUrl}}/courses/"
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Course\",\n  \"description\": \"Updated course description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{courseUrl}}/courses/{{courseId}}"
          }
        },
        {
          "name": "Delete Course",
          "request": {
            "method": "DELETE",
            "url": "{{courseUrl}}/courses/{{courseId}}"
          }
        }
      ]
    },
    {
      "name": "Enrollments",
      "item": [
        {
          "name": "Create Enrollment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": 1,\n  \"course_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{courseUrl}}/enrollments"
          }
        },
        {
          "name": "List Course Enrollments",
          "request": {
            "method": "GET",
            "url": "{{courseUrl}}/courses/{{courseId}}/enrollments"
          }
        }
      ]
    },
    {
      "name": "API Gateway",
      "item": [
        {
          "name": "List Students through Gateway",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/students/"
          }
        },
        {
          "name": "List Courses through Gateway",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses/"
          }
        }
      ]
    }
  ]
}